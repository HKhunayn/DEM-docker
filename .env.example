# Docker Compose host ports - three independently runnable apps:
#   engine         build + serve tiles; THE address other apps use. PUBLIC,
#                  but only tile serving: tiles, ArcGIS ImageServer metadata
#                  (?f=json) + tilemap, /tiles/terrain.json, imagery tiles,
#                  /health and the viewer's read-only GETs. Build jobs, job
#                  status, conversion status, /docs ... answer 403 there.
#                  (http://<host>:5000/arcgis/rest/services/<area>/ImageServer,
#                   http://<host>:5000/tiles/terrain.json)
#   data-platform  LOCAL ONLY: home page http://127.0.0.1:5100/ with
#                  Download data (/fetch/) and Data library (/library/:
#                  conversion status + Convert now). Talks to the engine on
#                  the internal compose network (engine:8787).
#   viewer         optional web viewer (http://<host>:3100/), public; it does
#                  not proxy the data-platform.
GIS_ENGINE_PORT=5000
GIS_DATA_PORT=5100
GIS_VIEWER_PORT=3100

# Host address the data-platform listens on. 127.0.0.1 (default) = only this
# machine (downloads and conversion control have no login). 0.0.0.0 = every
# interface (LAN) - only on a trusted network, or use an SSH tunnel instead:
#   ssh -L 5100:127.0.0.1:5100 user@server   then open http://127.0.0.1:5100/
# GIS_DATA_BIND=127.0.0.1
# (GIS_PLATFORM_PORT, the old name of the 5000 port, is still honoured when
#  GIS_ENGINE_PORT is not set.)

# Leave empty for the composed same-origin viewer. Set a full URL only when
# the viewer is hosted separately from the engine.
VITE_PLATFORM_URL=

# Optional: override the heightmap-30m DEM engine baked into the images
# (/opt/heightmap-30m, copied from gis-data-platform/engine). Set this to a
# local engine checkout and uncomment the bind mount in docker-compose.yml
# only when you develop the engine itself.
# HEIGHTMAP_ENGINE_ROOT=../heightmap-30m

# Hard memory caps: the engine builds tiles (big), the data-platform only
# downloads (small).
# GIS_ENGINE_MEM_LIMIT=20g
# GIS_DATA_MEM_LIMIT=2g

# Seconds between the engine's checks for newly downloaded areas (0 = only at
# engine start-up).
# GIS_AUTOBUILD_INTERVAL_S=60

# 0 = the engine never converts by itself (start-up / periodic); conversions
# then only run from "Convert now" in the data library or a download hand-off.
# GIS_AUTOBUILD=1

# Seconds between the engine's background refreshes of the tile counts shown
# in the data library (0 = only when the library asks).
# GIS_CONVERSION_WATCH_S=15
