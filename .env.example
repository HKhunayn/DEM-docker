# Docker Compose ports on the host
GIS_PLATFORM_PORT=8787
GIS_VIEWER_PORT=5173

# Leave empty for the composed same-origin viewer. Set a full URL only when
# the viewer is hosted separately from the data platform.
VITE_PLATFORM_URL=

# Optional: override the heightmap-30m DEM engine baked into the data-platform
# image (/opt/heightmap-30m, copied from gis-data-platform/engine). Set this to
# a local engine checkout and uncomment the bind mount in docker-compose.yml
# only when you develop the engine itself.
# HEIGHTMAP_ENGINE_ROOT=../heightmap-30m

# Hard memory cap for the data-platform container (API + tile builds).
# GIS_PLATFORM_MEM_LIMIT=20g
