# Docker Compose host ports - three independently runnable apps:
#   engine         build + serve tiles; THE address other apps use
#                  (http://<host>:5000/arcgis/rest/services/<area>/ImageServer,
#                   http://<host>:5000/tiles/terrain.json)
#   data-platform  downloads only (fetch page http://<host>:5100/fetch/)
#   viewer         optional web viewer (http://<host>:3100/)
GIS_ENGINE_PORT=5000
GIS_DATA_PORT=5100
GIS_VIEWER_PORT=3100
# (GIS_PLATFORM_PORT, the old name of the 5000 port, is still honoured when
#  GIS_ENGINE_PORT is not set.)

# Leave empty for the composed same-origin viewer. Set a full URL only when
# the viewer is hosted separately from the engine.
VITE_PLATFORM_URL=

# Optional: override the heightmap-30m DEM engine baked into the images
# (/opt/heightmap-30m, copied from gis-data-platform/engine). Set this to a
# local engine checkout and uncomment the bind mount in docker-compose.yml
# only when you develop the engine itself.
# HEIGHTMAP_ENGINE_ROOT=../heightmap-30m

# Hard memory caps: the engine builds tiles (big), the data-platform only
# downloads (small).
# GIS_ENGINE_MEM_LIMIT=20g
# GIS_DATA_MEM_LIMIT=2g

# Seconds between the engine's checks for newly downloaded areas (0 = only at
# engine start-up).
# GIS_AUTOBUILD_INTERVAL_S=60
